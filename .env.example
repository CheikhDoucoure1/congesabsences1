# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit real secrets.

# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-value

# Never set this to True on a server reachable by anyone but you — it leaks
# stack traces, source code, and settings (including DJANGO_SECRET_KEY) to
# any visitor who triggers an error.
DJANGO_DEBUG=False

# Comma-separated list of hostnames this app is allowed to answer for.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,conges-absences.petrosen.sn

# Comma-separated HTTPS origins allowed to submit Django forms.
DJANGO_CSRF_TRUSTED_ORIGINS=https://conges-absences.petrosen.sn

# Set to True once the app is actually served over HTTPS (enables secure
# cookies, HTTPS redirect and HSTS). Leave False for local http:// dev.
DJANGO_BEHIND_HTTPS=False

# --- Base de données (PostgreSQL) -------------------------------------------
DB_NAME=conges_absences
DB_USER=conges_absences
# Required — never commit a real value.
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- LDAP / Active Directory ------------------------------------------------
# Leave DJANGO_LDAP_ENABLED=False (or unset) to keep using local accounts
# only. When True, LDAP is tried first on login; local accounts (admin,
# demo users) still work as a fallback when the AD lookup fails or the
# server is unreachable — but a user auto-provisioned from AD has no local
# password to fall back to (AD is the sole source of truth for them; see
# conges/ldap_hooks.py).
DJANGO_LDAP_ENABLED=False
# This DC doesn't expose LDAPS (636) — plain LDAP on 389, confirmed working
# via ldapsearch. Credentials travel unencrypted unless DJANGO_LDAP_START_TLS
# below is turned on and the DC actually supports it.
DJANGO_LDAP_SERVER_URI=ldap://PETROSEN-SRV-DC1.PETROSEN.SN:389
DJANGO_LDAP_BASE_DN=DC=PETROSEN,DC=SN
# Use the UPN form (user@domain) here, NEVER `DOMAIN\user` — when this file
# is loaded via systemd's EnvironmentFile= (see the deploy service unit),
# systemd applies C-style backslash escaping to values, so `\a` silently
# becomes a control character instead of staying a literal backslash. This
# corrupts the bind DN with no visible error anywhere — it looks like every
# login just mysteriously fails. Confirmed the hard way in production.
DJANGO_LDAP_BIND_DN=adminclb@petrosen.sn
# Required once DJANGO_LDAP_ENABLED=True — never commit a real value.
DJANGO_LDAP_BIND_PASSWORD=

# Set to True only after confirming the DC supports STARTTLS on this same
# port 389 (ask IT, or test with `ldapsearch -ZZ ...`) — encrypts the
# connection without needing a separate 636 listener. Leave False otherwise:
# turning it on against a DC that doesn't support it breaks every login.
DJANGO_LDAP_START_TLS=False

# Only needed if the DC's TLS certificate (LDAPS or STARTTLS) is issued by
# an internal CA not already in this machine's trust store. Point it at
# that CA's PEM file. Never work around a certificate error by disabling
# validation instead.
DJANGO_LDAP_CA_CERT_FILE=

# Temporary — set to True while diagnosing a login issue to see every LDAP
# step in the server logs, then set back to False.
DJANGO_LDAP_DEBUG=False
